{
  "name": "photo-atlas",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "publish:portfolio": "npm run build && node scripts/publish-to-portfolio.mjs",
    "local": "node scripts/build.mjs && node local/cli.mjs serve",
    "scan": "node scripts/build.mjs && node local/cli.mjs scan"
  },
  "devDependencies": {
    "wrangler": "4.128.0"
  },
  "dependencies": {
    "exiftool-vendored": "^39.3.0",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22"
  }
}
